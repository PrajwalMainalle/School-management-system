# ==========================================
# SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# ==========================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# DATABASE CONFIGURATION
# Replace with your MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/school_erp_db?retryWrites=true&w=majority

# JWT AUTHENTICATION SECRET
JWT_SECRET=super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CLIENT URLS
FRONTEND_URL=http://localhost:5173
MOBILE_APP_URL=exp://localhost:19000

# CLOUD STORAGE (Optional / Phase 16+)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# EMAIL CONFIGURATION (Optional / Phase 16+)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
